@using Microsoft.AspNetCore.Identity
@using PawfectMatch.Data
@using PawfectMatch.Constants

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<div id="QuickMenu">

    @* Usamos AuthorizeView para mostrar contenido diferente si el usuario está logueado o no *@
    <AuthorizeView>
        <Authorized>
            @* --- 1. Botón especial para el Usuario --- *@
            <QuickFunc IconName="person-circle" Text="@context.User.Identity?.Name" OnClick="ToggleUserModal"></QuickFunc>

            @* --- 2. Navegación principal (máximo 6 botones más) --- *@
            <QuickFunc IconName="house-door-fill" Text="Inicio" OnClick="@(() => NavigationManager.NavigateTo("/"))" />

            @* Agrupamos funcionalidades relacionadas con ventas/productos en un solo botón que lleva al POS *@
            <AuthorizeView Policy="@Permissions.Sales.View" Context="ventas">
                <QuickFunc IconName="cart3" Text="Punto de Venta" OnClick="@(() => NavigationManager.NavigateTo(Urls.Ventas.POS))" />
            </AuthorizeView>

            @* Mascotas - funcionalidad principal de la aplicación *@
            <QuickFunc IconName="heart-fill" Text="Mascotas" OnClick="@(() => NavigationManager.NavigateTo(Urls.Mascotas.IndexAdopcion))" />

            @* Administración - acceso a todas las funciones administrativas *@
            <AuthorizeView Policy="@Permissions.Admin.AccessPanel" Context="admin">
                <QuickFunc IconName="gear-fill" Text="Administración" OnClick="@(() => NavigationManager.NavigateTo("/admin"))" />
            </AuthorizeView>

            @* Gestión de inventario y productos (para usuarios con permisos) *@
            <AuthorizeView Policy="@Permissions.Products.View" Context="productos">
                <QuickFunc IconName="box-seam" Text="Inventario" OnClick="@(() => NavigationManager.NavigateTo("/productos"))" />
            </AuthorizeView>

            @* Configuración personal del usuario *@
            <QuickFunc IconName="person-gear" Text="Mi Cuenta" OnClick="@(() => NavigationManager.NavigateTo(Urls.Account.Manage))" />

        </Authorized>
        <NotAuthorized>
            @* Si el usuario no está logueado, mostramos botones específicos para visitantes *@
            <QuickFunc IconName="house-door-fill" Text="Inicio" OnClick="@(() => NavigationManager.NavigateTo("/"))" />
            <QuickFunc IconName="heart-fill" Text="Adoptar" OnClick="@(() => NavigationManager.NavigateTo(Urls.Mascotas.IndexAdopcion))" />
            <QuickFunc IconName="info-circle" Text="Nosotros" OnClick="@(() => NavigationManager.NavigateTo(Urls.Informacion.Nosotros))" />
            <QuickFunc IconName="box-arrow-in-right" Text="Iniciar Sesión" OnClick="@(() => NavigationManager.NavigateTo(Urls.Account.Login))" />
        </NotAuthorized>
    </AuthorizeView>

    @* --- 3. El Modal del Usuario --- *@
    @if (isUserModalVisible)
    {
        @* El fondo oscuro que cubre la pantalla *@
        <div class="user-modal-overlay" @onclick="ToggleUserModal">

            @* El contenido del modal. @onclick:stopPropagation evita que el clic en el modal cierre el overlay. *@
            <div class="user-modal-content" @onclick:stopPropagation="true">

                <div class="user-modal-header">
                    <h3>Cuenta de Usuario</h3>
                    <button class="user-modal-close-btn" @onclick="ToggleUserModal" title="Cerrar">&times;</button>
                </div>

                <div class="user-modal-body">
                    <i class="bi bi-person-check-fill user-modal-icon"></i>
                    <p>Sesión iniciada como:</p>
                    <strong>@UserName</strong>
                    
                    @* Accesos rápidos desde el modal del usuario *@
                    <div class="user-quick-links">
                        <AuthorizeView Policy="@Permissions.Sales.View">
                            <a href="@Urls.Facturas.Index" class="quick-link" @onclick="ToggleUserModal">
                                <i class="bi bi-receipt"></i>
                                <span>Facturas</span>
                            </a>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Permissions.Products.View">
                            <a href="@Urls.Proveedores.Index" class="quick-link" @onclick="ToggleUserModal">
                                <i class="bi bi-building"></i>
                                <span>Proveedores</span>
                            </a>
                        </AuthorizeView>
                        <a href="@Urls.Account.Manage" class="quick-link" @onclick="ToggleUserModal">
                            <i class="bi bi-person-gear"></i>
                            <span>Configurar Perfil</span>
                        </a>
                    </div>
                </div>

                <div class="user-modal-footer">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="user-modal-logout-btn">
                            <i class="bi bi-box-arrow-right"></i>
                            Cerrar Sesión
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
@code {
    private bool isUserModalVisible = false;
    private string? UserName { get; set; }

    private string? currentUrl;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var authState = await AuthenticationStateTask;
        var user = authState.User;
        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            UserName = user.Identity.Name;
        }
    }

    private void ToggleUserModal()
    {
        isUserModalVisible = !isUserModalVisible;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        await SignInManager.SignOutAsync();
        // NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
