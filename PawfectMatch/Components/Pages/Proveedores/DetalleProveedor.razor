@page "/proveedores/{id:int}"
@using PawfectMatch.Models
@using PawfectMatch.Constants
@inject ProveedoresService ProveedoresService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize(Policy = Permissions.Products.View)]

<div class="proveedor-detalle-container">
    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>Cargando detalles del proveedor...</p>
        </div>
    }
    else if (proveedor == null || proveedor.ProveedoresID == 0)
    {
        <div class="not-found-container">
            <div class="not-found-icon">
                <i class="bi bi-building-x"></i>
            </div>
            <h2>Proveedor No Encontrado</h2>
            <p>El proveedor que estás buscando no existe o ha sido eliminado.</p>
            <button class="btn-back" @onclick="Volver">Volver a Proveedores</button>
        </div>
    }
    else
    {
        <div class="proveedor-header">
            <div class="header-left">
                <button class="btn-back" @onclick="Volver">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </button>
                <div class="proveedor-title">
                    <h1>@proveedor.Nombre</h1>
                    <div class="proveedor-badges">
                        <span class="badge badge-id">ID: #@proveedor.ProveedoresID.ToString("D3")</span>
                        <span class="badge badge-rnc">RNC: @proveedor.RNC</span>
                    </div>
                </div>
            </div>
            <div class="header-actions">
                <AuthorizeView Policy="@Permissions.Products.Edit">
                    <button class="btn-edit" @onclick="EditarProveedor">
                        <i class="bi bi-pencil"></i>
                        Editar
                    </button>
                </AuthorizeView>
            </div>
        </div>

        <div class="proveedor-content">
            <!-- Información básica -->
            <div class="proveedor-section info-section">
                <h3 class="section-title">
                    <i class="bi bi-building"></i>
                    Información del Proveedor
                </h3>
                
                <div class="info-grid">
                    <div class="info-card">
                        <div class="info-header">
                            <i class="bi bi-person-badge"></i>
                            <span>Nombre</span>
                        </div>
                        <div class="info-value">@proveedor.Nombre</div>
                    </div>
                    
                    <div class="info-card">
                        <div class="info-header">
                            <i class="bi bi-card-text"></i>
                            <span>RNC</span>
                        </div>
                        <div class="info-value">@proveedor.RNC</div>
                    </div>
                </div>
            </div>

            <!-- Información de contacto -->
            <div class="proveedor-section contact-section">
                <h3 class="section-title">
                    <i class="bi bi-telephone"></i>
                    Información de Contacto
                </h3>
                
                <div class="contact-grid">
                    @if (!string.IsNullOrEmpty(proveedor.Telefono))
                    {
                        <div class="contact-card">
                            <div class="contact-icon">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div class="contact-info">
                                <span class="contact-label">Teléfono</span>
                                <span class="contact-value">@proveedor.Telefono</span>
                            </div>
                            <a href="tel:@proveedor.Telefono" class="contact-action">
                                <i class="bi bi-telephone"></i>
                            </a>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(proveedor.Email))
                    {
                        <div class="contact-card">
                            <div class="contact-icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div class="contact-info">
                                <span class="contact-label">Email</span>
                                <span class="contact-value">@proveedor.Email</span>
                            </div>
                            <a href="mailto:@proveedor.Email" class="contact-action">
                                <i class="bi bi-envelope"></i>
                            </a>
                        </div>
                    }
                    
                    @if (string.IsNullOrEmpty(proveedor.Telefono) && string.IsNullOrEmpty(proveedor.Email))
                    {
                        <div class="no-contact">
                            <i class="bi bi-exclamation-circle"></i>
                            <p>No hay información de contacto registrada.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Estadísticas -->
            <div class="proveedor-section stats-section">
                <h3 class="section-title">
                    <i class="bi bi-graph-up"></i>
                    Estadísticas
                </h3>
                
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">0</span>
                            <span class="stat-label">Productos Suministrados</span>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="bi bi-calendar-date"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">-</span>
                            <span class="stat-label">Última Compra</span>
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">$0.00</span>
                            <span class="stat-label">Total Compras</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Proveedores? proveedor;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            proveedor = await ProveedoresService.SearchByIdAsync(Id);
        }
        catch (Exception)
        {
            // Manejar error de carga
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo(Urls.Proveedores.Index);
    }

    private void EditarProveedor()
    {
        NavigationManager.NavigateTo($"{Urls.Proveedores.Editar}{Id}");
    }
}