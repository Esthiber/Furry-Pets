@page "/admin/solicitudes"
@attribute [Authorize(Policy = Permissions.AdoptionRequests.View)]
@inject SolicitudesAdopcionesService SolicitudesService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@using PawfectMatch.Constants
@using System.Security.Claims

@rendermode InteractiveServer

<PageTitle>Gestión de Solicitudes de Adopción | Pawfect Match</PageTitle>

<div class="solicitudes-admin-container">
    <header class="page-header">
        <div class="header-content">
            <div class="title-section">
                <h3>Gestión de Solicitudes de Adopción</h3>
                <p>Administra todas las solicitudes de adopción de mascotas del sistema.</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo(Urls.Administracion.Panel))">
                    <i class="bi bi-arrow-left"></i> Volver al Panel
                </button>
                <button class="btn btn-primary" @onclick="CargarDatos">
                    <i class="bi bi-arrow-clockwise"></i> Actualizar
                </button>
            </div>
        </div>
    </header>

    <!-- Stats Cards -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-card stat-pending">
                <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                <div class="stat-content">
                    <h4>@solicitudesPendientes</h4>
                    <p>Pendientes</p>
                </div>
            </div>
            <div class="stat-card stat-approved">
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                <div class="stat-content">
                    <h4>@solicitudesAprobadas</h4>
                    <p>Aprobadas</p>
                </div>
            </div>
            <div class="stat-card stat-rejected">
                <div class="stat-icon"><i class="bi bi-x-circle"></i></div>
                <div class="stat-content">
                    <h4>@solicitudesRechazadas</h4>
                    <p>Rechazadas</p>
                </div>
            </div>
            <div class="stat-card stat-total">
                <div class="stat-icon"><i class="bi bi-collection"></i></div>
                <div class="stat-content">
                    <h4>@solicitudesTotal</h4>
                    <p>Total</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Filters Section -->
    <section class="filters-section card">
        <div class="filters-header">
            <h5><i class="bi bi-funnel"></i> Filtros y Búsqueda</h5>
            @if (HasActiveFilters)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="LimpiarFiltros">
                    <i class="bi bi-x-circle"></i> Limpiar Filtros
                </button>
            }
        </div>
        
        <div class="filters-content">
            <div class="filter-row">
                <div class="filter-group">
                    <label>Buscar</label>
                    <div class="search-input-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Buscar por nombre de mascota, adoptante o email..."
                               @bind="busqueda" 
                               @bind:event="oninput"
                               @onkeyup="AplicarFiltros" />
                        @if (!string.IsNullOrEmpty(busqueda))
                        {
                            <button class="clear-search-btn" @onclick="LimpiarBusqueda">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>
                
                <div class="filter-group">
                    <label>Estado</label>
                    <select class="form-select" @bind="filtroEstado" @bind:after="AplicarFiltros">
                        <option value="0">Todos los estados</option>
                        <option value="1">Pendientes</option>
                        <option value="2">Aprobadas</option>
                        <option value="3">Rechazadas</option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label>Fecha desde</label>
                    <input type="date" class="form-control" @bind="fechaDesde" @bind:after="AplicarFiltros" />
                </div>
                
                <div class="filter-group">
                    <label>Fecha hasta</label>
                    <input type="date" class="form-control" @bind="fechaHasta" @bind:after="AplicarFiltros" />
                </div>
            </div>
        </div>
    </section>

    <!-- Results Section -->
    <section class="results-section">
        @if (isLoading)
        {
            <div class="loading-container">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Cargando solicitudes...</p>
            </div>
        }
        else
        {
            <div class="results-header">
                <div class="results-info">
                    <span class="results-count">
                        Mostrando @solicitudesFiltradas.Count de @todasLasSolicitudes.Count solicitudes
                    </span>
                </div>
                <div class="results-actions">
                    <div class="sort-dropdown">
                        <select class="form-select form-select-sm" @bind="ordenamiento" @bind:after="AplicarFiltros">
                            <option value="fecha-desc">Fecha ?</option>
                            <option value="fecha-asc">Fecha ?</option>
                            <option value="estado">Estado</option>
                            <option value="mascota">Mascota</option>
                            <option value="adoptante">Adoptante</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (!solicitudesFiltradas.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-search"></i>
                    </div>
                    <h4>No se encontraron solicitudes</h4>
                    <p>
                        @if (HasActiveFilters)
                        {
                            <span>No hay solicitudes que coincidan con los filtros seleccionados.</span>
                        }
                        else
                        {
                            <span>Aún no se han registrado solicitudes de adopción en el sistema.</span>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="solicitudes-table-container">
                    <div class="table-responsive">
                        <table class="table table-hover solicitudes-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Mascota</th>
                                    <th>Adoptante</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var solicitud in solicitudesFiltradas)
                                {
                                    <tr class="solicitud-row @GetRowClass(solicitud.EstadoSolicitudID)">
                                        <td>
                                            <span class="solicitud-id">#@solicitud.SolicitudesAdopcionesID</span>
                                        </td>
                                        <td>
                                            <div class="mascota-cell">
                                                @if (!string.IsNullOrEmpty(solicitud.MascotaAdopcion?.FotoURL))
                                                {
                                                    <img src="@solicitud.MascotaAdopcion.FotoURL" alt="@solicitud.MascotaAdopcion.Nombre" class="mascota-avatar" />
                                                }
                                                else
                                                {
                                                    <div class="mascota-avatar-placeholder">
                                                        <i class="bi bi-heart"></i>
                                                    </div>
                                                }
                                                <div class="mascota-info">
                                                    <span class="mascota-nombre">@solicitud.MascotaAdopcion?.Nombre</span>
                                                    <small class="mascota-raza">@solicitud.MascotaAdopcion?.Razas?.Nombre</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="adoptante-cell">
                                                <div class="adoptante-avatar">
                                                    @GetInitials(solicitud.Persona?.Nombre)
                                                </div>
                                                <div class="adoptante-info">
                                                    <span class="adoptante-nombre">@solicitud.Persona?.Nombre</span>
                                                    <small class="adoptante-email">@solicitud.Persona?.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fecha-cell">
                                                <span class="fecha-principal">@solicitud.Fecha.ToString("dd/MM/yyyy")</span>
                                                <small class="fecha-hora">@solicitud.Fecha.ToString("HH:mm")</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="estado-badge @GetEstadoBadgeClass(solicitud.EstadoSolicitudID)">
                                                @GetEstadoNombre(solicitud.EstadoSolicitudID)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="actions-cell">
                                                <AuthorizeView Policy="@Permissions.AdoptionRequests.ViewDetails">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            @onclick="@(() => VerDetalles(solicitud.SolicitudesAdopcionesID))"
                                                            title="Ver detalles">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </AuthorizeView>

                                                @if (solicitud.EstadoSolicitudID == 1) // Solo para pendientes
                                                {
                                                    <AuthorizeView Policy="@Permissions.AdoptionRequests.Approve">
                                                        <button class="btn btn-sm btn-outline-success" 
                                                                @onclick="@(() => AprobarSolicitud(solicitud.SolicitudesAdopcionesID))"
                                                                title="Aprobar">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </AuthorizeView>

                                                    <AuthorizeView Policy="@Permissions.AdoptionRequests.Reject">
                                                        <button class="btn btn-sm btn-outline-danger" 
                                                                @onclick="@(() => RechazarSolicitud(solicitud.SolicitudesAdopcionesID))"
                                                                title="Rechazar">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </AuthorizeView>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </section>
</div>

