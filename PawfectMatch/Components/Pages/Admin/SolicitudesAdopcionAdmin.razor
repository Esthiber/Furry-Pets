@code {
    // State variables
    private List<SolicitudesAdopciones> todasLasSolicitudes = new();
    private List<SolicitudesAdopciones> solicitudesFiltradas = new();
    private bool isLoading = true;

    // Filter variables
    private string busqueda = string.Empty;
    private int filtroEstado = 0;
    private DateTime? fechaDesde = null;
    private DateTime? fechaHasta = null;
    private string ordenamiento = "fecha-desc";

    // Stats
    private int solicitudesPendientes = 0;
    private int solicitudesAprobadas = 0;
    private int solicitudesRechazadas = 0;
    private int solicitudesTotal = 0;

    private bool HasActiveFilters => 
        !string.IsNullOrEmpty(busqueda) || 
        filtroEstado != 0 || 
        fechaDesde != null || 
        fechaHasta != null;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            todasLasSolicitudes = await SolicitudesService.ListAsync(s => !s.IsDeleted);
            CalcularEstadisticas();
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading adoption requests: {ex.Message}");
            todasLasSolicitudes = new List<SolicitudesAdopciones>();
            solicitudesFiltradas = new List<SolicitudesAdopciones>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CalcularEstadisticas()
    {
        solicitudesTotal = todasLasSolicitudes.Count;
        solicitudesPendientes = todasLasSolicitudes.Count(s => s.EstadoSolicitudID == 1);
        solicitudesAprobadas = todasLasSolicitudes.Count(s => s.EstadoSolicitudID == 2);
        solicitudesRechazadas = todasLasSolicitudes.Count(s => s.EstadoSolicitudID == 3);
    }

    private void AplicarFiltros()
    {
        solicitudesFiltradas = todasLasSolicitudes.ToList();

        // Filtro de búsqueda
        if (!string.IsNullOrEmpty(busqueda))
        {
            var searchLower = busqueda.ToLower();
            solicitudesFiltradas = solicitudesFiltradas.Where(s =>
                (s.MascotaAdopcion?.Nombre?.ToLower().Contains(searchLower) ?? false) ||
                (s.Persona?.Nombre?.ToLower().Contains(searchLower) ?? false) ||
                (s.Persona?.Email?.ToLower().Contains(searchLower) ?? false)
            ).ToList();
        }

        // Filtro de estado
        if (filtroEstado != 0)
        {
            solicitudesFiltradas = solicitudesFiltradas.Where(s => s.EstadoSolicitudID == filtroEstado).ToList();
        }

        // Filtro de fecha desde
        if (fechaDesde != null)
        {
            solicitudesFiltradas = solicitudesFiltradas.Where(s => s.Fecha.Date >= fechaDesde.Value.Date).ToList();
        }

        // Filtro de fecha hasta
        if (fechaHasta != null)
        {
            solicitudesFiltradas = solicitudesFiltradas.Where(s => s.Fecha.Date <= fechaHasta.Value.Date).ToList();
        }

        // Aplicar ordenamiento
        solicitudesFiltradas = ordenamiento switch
        {
            "fecha-asc" => solicitudesFiltradas.OrderBy(s => s.Fecha).ToList(),
            "fecha-desc" => solicitudesFiltradas.OrderByDescending(s => s.Fecha).ToList(),
            "estado" => solicitudesFiltradas.OrderBy(s => s.EstadoSolicitudID).ThenByDescending(s => s.Fecha).ToList(),
            "mascota" => solicitudesFiltradas.OrderBy(s => s.MascotaAdopcion?.Nombre).ToList(),
            "adoptante" => solicitudesFiltradas.OrderBy(s => s.Persona?.Nombre).ToList(),
            _ => solicitudesFiltradas.OrderByDescending(s => s.Fecha).ToList()
        };

        StateHasChanged();
    }

    private void LimpiarFiltros()
    {
        busqueda = string.Empty;
        filtroEstado = 0;
        fechaDesde = null;
        fechaHasta = null;
        ordenamiento = "fecha-desc";
        AplicarFiltros();
    }

    private void LimpiarBusqueda()
    {
        busqueda = string.Empty;
        AplicarFiltros();
    }

    private async Task AprobarSolicitud(int solicitudId)
    {
        try
        {
            var solicitud = await SolicitudesService.SearchByIdAsync(solicitudId);
            if (solicitud != null && solicitud.SolicitudesAdopcionesID > 0)
            {
                solicitud.EstadoSolicitudID = 2; // Aprobada
                bool resultado = await SolicitudesService.UpdateAsync(solicitud);
                
                if (resultado)
                {
                    await CargarDatos(); // Recargar datos
                    await JS.InvokeVoidAsync("alert", "Solicitud aprobada exitosamente.");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Error al aprobar la solicitud.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error approving request: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error al aprobar la solicitud.");
        }
    }

    private async Task RechazarSolicitud(int solicitudId)
    {
        try
        {
            var solicitud = await SolicitudesService.SearchByIdAsync(solicitudId);
            if (solicitud != null && solicitud.SolicitudesAdopcionesID > 0)
            {
                solicitud.EstadoSolicitudID = 3; // Rechazada
                bool resultado = await SolicitudesService.UpdateAsync(solicitud);
                
                if (resultado)
                {
                    await CargarDatos(); // Recargar datos
                    await JS.InvokeVoidAsync("alert", "Solicitud rechazada exitosamente.");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Error al rechazar la solicitud.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rejecting request: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error al rechazar la solicitud.");
        }
    }

    private void VerDetalles(int solicitudId)
    {
        NavigationManager.NavigateTo($"{Urls.Solicitudes.Detalle}{solicitudId}");
    }

    private string GetRowClass(int estadoId)
    {
        return estadoId switch
        {
            1 => "pending",
            2 => "approved",
            3 => "rejected",
            _ => ""
        };
    }

    private string GetEstadoBadgeClass(int estadoId)
    {
        return estadoId switch
        {
            1 => "pendiente",
            2 => "aprobada",
            3 => "rechazada",
            _ => ""
        };
    }

    private string GetEstadoNombre(int estadoId)
    {
        return estadoId switch
        {
            1 => "Pendiente",
            2 => "Aprobada",
            3 => "Rechazada",
            _ => "Desconocido"
        };
    }

    private string GetInitials(string? nombre)
    {
        if (string.IsNullOrEmpty(nombre)) return "?";
        
        var parts = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }
        return nombre[0].ToString().ToUpper();
    }
}