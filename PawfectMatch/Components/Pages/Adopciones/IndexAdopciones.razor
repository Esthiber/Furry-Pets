@page "/catalogo"
@using PawfectMatch.Models.Adopciones
@using PawfectMatch.Constants
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@inject MascotasAdopcionService MascotaService

@attribute [Authorize(Policy = Permissions.Pets.View)]

<div class="adopciones-container">
    <header class="adopciones-header">
        <h1>Mascotas en Adopción</h1>
        <p>Encuentra a tu compañero ideal y dale un hogar lleno de amor.</p>
    </header>

    <section class="adopciones-filtros">
        <div class="filtros-row">
            <div class="filtro-item">
                <label for="filtro-nombre">Nombre</label>
                <InputText id="filtro-nombre" class="form-control" placeholder="Buscar por nombre..." @bind-Value="FiltroNombre" @onkeyup="AplicarFiltros" />
            </div>
            <div class="filtro-item">
                <label for="filtro-edad">Edad</label>
                <InputSelect id="filtro-edad" class="form-select" @bind-Value="FiltroEdad" @onchange="AplicarFiltros">
                    <option value="">Todas las edades</option>
                    <option value="cachorro">Cachorro (0-1 año)</option>
                    <option value="joven">Joven (1-3 años)</option>
                    <option value="adulto">Adulto (3-8 años)</option>
                    <option value="senior">Senior (8+ años)</option>
                </InputSelect>
            </div>
            <div class="filtro-item">
                <label for="filtro-tamanio">Tamaño</label>
                <InputSelect id="filtro-tamanio" class="form-select" @bind-Value="FiltroTamanio" @onchange="AplicarFiltros">
                    <option value="">Todos los tamaños</option>
                    @foreach (var tamano in TamaniosDisponibles)
                    {
                        <option value="@tamano">@tamano</option>
                    }
                </InputSelect>
            </div>
        </div>
        <div class="filtros-actions">
            <button class="btn btn-primary" @onclick="AplicarFiltros">
                <i class="bi bi-search"></i> Buscar
            </button>
            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                <i class="bi bi-x-circle"></i> Limpiar filtros
            </button>
        </div>
    </section>

    <section class="adopciones-resultados">
        @if (MascotasFiltradas != null && MascotasFiltradas.Any())
        {
            <p>@MascotasFiltradas.Count mascota(s) encontrada(s)</p>
        }
        else
        {
            <p>No se encontraron mascotas con los filtros seleccionados.</p>
        }
    </section>

    <section class="adopciones-grid">
        @if (MascotasFiltradas != null && MascotasFiltradas.Any())
        {
            @foreach (var mascota in MascotasFiltradas)
            {
                <div class="mascota-card">
                    <img src="@(mascota.FotoURL ?? "https://via.placeholder.com/150")" alt="@mascota.Nombre" class="mascota-img" />
                    <div class="mascota-info">
                        <h3>@mascota.Nombre</h3>
                        <p><strong>Edad:</strong> @CalculateAge(mascota.FechaNacimiento)</p>
                        <p><strong>Tamaño:</strong> @mascota.RelacionSize?.Nombre</p>
                        <p><strong>Raza:</strong> @mascota.Razas?.Nombre</p>
                        <button class="btn btn-primary" @onclick="() => VerDetalles(mascota.MascotasAdopcionID)">Ver detalles</button>
                    </div>
                </div>
            }
        }
    </section>
</div>

@code {
    string FiltroNombre = "";
    string FiltroEdad = "";
    string FiltroTamanio = "";

    List<MascotasAdopcion>? TodasMascotas;
    List<MascotasAdopcion>? MascotasFiltradas;
    List<string> TamaniosDisponibles => TodasMascotas?
        .Select(m => m.RelacionSize?.Nombre!)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        TodasMascotas = await MascotaService.ListAsync(m => !m.IsDeleted && m.Estado!.Nombre.ToLower() == "disponible");
        AplicarFiltros();
    }

    void VerDetalles(int id)
    {
        NavigationManager.NavigateTo($"{Urls.Mascotas.Detalle}{id}");
    }

    void LimpiarFiltros()
    {
        FiltroNombre = "";
        FiltroEdad = "";
        FiltroTamanio = "";
        AplicarFiltros();
    }

    void AplicarFiltros()
    {
        if (TodasMascotas == null) return;
        MascotasFiltradas = TodasMascotas
            .Where(m =>
                (string.IsNullOrEmpty(FiltroNombre) || m.Nombre.Contains(FiltroNombre, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(FiltroEdad) || EdadCoincide(m.FechaNacimiento, FiltroEdad)) &&
                (string.IsNullOrEmpty(FiltroTamanio) || m.RelacionSize?.Nombre == FiltroTamanio))
            .ToList();
    }

    bool EdadCoincide(DateOnly? fechaNac, string filtro)
    {
        if (fechaNac is null) return false;
        var hoy = DateTime.Today;
        var edad = hoy.Year - fechaNac.Value.Year;
        if (fechaNac.Value.AddYears(edad) > DateOnly.FromDateTime(hoy))
            edad--;
        return filtro switch
        {
            "cachorro" => edad <= 1,
            "joven" => edad > 1 && edad <= 3,
            "adulto" => edad > 3 && edad <= 8,
            "senior" => edad > 8,
            _ => true
        };
    }

    string CalculateAge(DateOnly? fechaNacimiento)
    {
        if (fechaNacimiento is null) return "Desconocida";
        var hoy = DateTime.Today;
        var edad = hoy.Year - fechaNacimiento.Value.Year;
        if (fechaNacimiento.Value.AddYears(edad) > DateOnly.FromDateTime(hoy))
            edad--;
        return edad > 0 ? $"{edad} año(s)" : "Menos de un año";
    }
}
