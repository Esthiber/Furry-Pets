@page "/configuracion/backup"
@using PawfectMatch.Constants
@attribute [Authorize(Policy = Permissions.Backups.View)]
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="backup-container">
    <div class="backup-card">
        <div class="success-icon">
            <i class="bi bi-database-gear"></i>
        </div>
        <h2 class="backup-title">Respaldo de Base de Datos</h2>
        <div class="backup-details">
            <div class="backup-message">
                Gestiona y protege la información de tu sistema con copias de seguridad.
            </div>
            <div class="backup-info">
                <div class="info-item">
                    <span class="info-label"><i class="bi bi-check-circle"></i> Estado</span>
                    <span class="info-value">Conexión activa</span>
                </div>
                <div class="info-item">
                    <span class="info-label"><i class="bi bi-clock"></i> Último respaldo</span>
                    <span class="info-value">Hace 2 días</span>
                </div>
                <div class="info-item">
                    <span class="info-label"><i class="bi bi-hdd"></i> Espacio disponible</span>
                    <span class="info-value">@GetRandomFileSize() GB</span>
                </div>
                <div class="info-item">
                    <span class="info-label"><i class="bi bi-exclamation-triangle"></i> Recomendación</span>
                    <span class="info-value">Crear un nuevo respaldo</span>
                </div>
            </div>
        </div>
        <div class="backup-actions">
            <AuthorizeView Policy="@Permissions.Backups.Create">
                <select class="form-select" style="width:90px;margin-right:0.5rem;" @bind="selectedFormat">
                    <option value="csv">CSV</option>
                    <option value="excel">Excel</option>
                </select>
                <button class="btn-primary" @onclick="DescargarBackup">
                    <i class="bi bi-download"></i> Crear
                </button>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.Backups.Restore">
                <button class="btn-secondary" disabled>
                    <i class="bi bi-upload"></i> Restaurar
                </button>
            </AuthorizeView>
            <button class="btn-secondary" disabled>
                <i class="bi bi-gear"></i> Programar
            </button>
            <button class="btn-secondary" @onclick="VolverAConfiguracion">
                <i class="bi bi-arrow-left"></i> Volver
            </button>
        </div>
        <div style="margin-top:1rem;">
            <h4 style="margin-bottom:0.5rem;font-size:1.1rem;">Historial de Respaldos</h4>
            <table class="table table-striped" style="width:100%;margin-bottom:0;">
                <thead>
                    <tr>
                        <th style="font-size:0.95rem;">Fecha</th>
                        <th style="font-size:0.95rem;">Tamaño</th>
                        <th style="font-size:0.95rem;">Estado</th>
                        <th style="font-size:0.95rem;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@DateTime.Now.AddDays(-2).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@GetRandomFileSize() MB</td>
                        <td><span class="status-badge success">Completado</span></td>
                        <td>
                            <button class="btn-icon" title="Descargar" style="padding:0.2rem 0.5rem;font-size:1rem;">
                                <i class="bi bi-download"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>@DateTime.Now.AddDays(-7).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@GetRandomFileSize() MB</td>
                        <td><span class="status-badge success">Completado</span></td>
                        <td>
                            <button class="btn-icon" title="Descargar" style="padding:0.2rem 0.5rem;font-size:1rem;">
                                <i class="bi bi-download"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>@DateTime.Now.AddDays(-14).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@GetRandomFileSize() MB</td>
                        <td><span class="status-badge success">Completado</span></td>
                        <td>
                            <button class="btn-icon" title="Descargar" style="padding:0.2rem 0.5rem;font-size:1rem;">
                                <i class="bi bi-download"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string selectedFormat = "csv";

    protected override void OnInitialized()
    {
        ToastService.ShowSuccess("Backup guardado exitosamente");
    }

    private async Task DescargarBackup()
    {
        // Llama al endpoint del servidor para crear y descargar el respaldo
        var endpoint = selectedFormat == "excel"
            ? "/api/Backup/excel"
            : "/api/Backup/csv";

        // Usar JS interop para descargar el archivo generado en el servidor
        await JS.InvokeVoidAsync("open", endpoint, "_blank");
        ToastService.ShowSuccess($"Respaldo generado en formato {selectedFormat.ToUpper()}.");
    }

    private void VolverAConfiguracion()
    {
        NavigationManager.NavigateTo("/admin");
    }

    private string GetRandomFileSize()
    {
        Random random = new Random();
        return (random.Next(5, 50) + random.NextDouble()).ToString("0.00");
    }
}